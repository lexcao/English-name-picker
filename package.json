{
  "name": "english-name-picker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "generate:data": "node scripts/build-data.mjs",
    "deploy": "npm run build && gh-pages -d dist --add",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "devDependencies": {
    "vite": "8.0.14",
    "typescript": "5.9.3",
    "gh-pages": "6.3.0"
  }
}
